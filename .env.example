# ---- Flask (required) ----
# Long random string used to sign session cookies (e.g. openssl rand -hex 32)
FLASK_SECRET_KEY=replace-with-long-random-string

# Password for /login (only you and people you share it with should know this)
ACCESS_PASSWORD=replace-with-a-strong-password

# ---- Tractive (required) ----
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=your-tractive-app-password
TRACTIVE_TRACKER_ID=your-tracker-uuid
# Optional: only if Tractive blocks the default app id (same as Tractive mobile client id if you find a newer one)
# TRACTIVE_CLIENT_ID=625e533dc3c3b41c28a669f0
# Optional: positions API format (default json_segments — matches Tractive mobile / aiotractive)
# TRACTIVE_POSITIONS_FORMAT=json_segments

# ---- Strava OAuth (required) ----
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your-client-secret
# Set this to: https://YOUR_RAILWAY_DOMAIN.up.railway.app/auth/callback
STRAVA_REDIRECT_URI=https://example.com/auth/callback
# For local dev you can also use: http://127.0.0.1:5000/auth/callback
# and add the same to Strava "Authorization Callback Domain"

# Initial tokens after completing OAuth in browser; refreshed values are written
# to /tmp/strava_tokens.json on the server and should be re-copied to Railway
# if Strava issues a new refresh token.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
# Unix timestamp (seconds) when the access token expires, if known
STRAVA_TOKEN_EXPIRES_AT=0
